# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared DGL passcode - change this before launch, keep it out of git
DGL_PASSCODE=DGL2027

# Optional: comma-separated list, leave blank to skip IP rate limiting bypass
